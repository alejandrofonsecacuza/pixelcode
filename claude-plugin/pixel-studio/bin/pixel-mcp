#!/bin/sh
# Launcher for the pixelcode MCP server, used by the pixel-studio plugin.
#
# Finds a `pixel` binary in this order and runs `pixel mcp`:
#   1. $PIXEL_BIN, when set.
#   2. The binary built in this repository (development: plugin installed from a local checkout).
#   3. One already downloaded into the cache, of this exact version.
#   4. `pixel` on the PATH, when it is this exact version.
#   5. Downloads it from GitHub Releases for this platform and verifies its SHA-256.
#
# Every message goes to stderr: stdout is the MCP protocol channel.
set -eu

VERSION="0.1.0"
REPO="${PIXELCODE_REPO:-alejandrofonsecacuza/pixelcode}"
BASE_URL="${PIXELCODE_BASE_URL:-https://github.com/$REPO/releases/download/v$VERSION}"

log() { printf 'pixel-mcp: %s\n' "$*" >&2; }

root="$(cd "$(dirname "$0")/.." && pwd)"

if [ -n "${PIXEL_BIN:-}" ]; then
    exec "$PIXEL_BIN" mcp
fi

dev="$root/../../target/release/pixel"
if [ -x "$dev" ]; then
    exec "$dev" mcp
fi

cache="${CLAUDE_PLUGIN_DATA:-${XDG_CACHE_HOME:-$HOME/.cache}/pixelcode}"
bin="$cache/pixel-$VERSION"
if [ -x "$bin" ]; then
    exec "$bin" mcp
fi

if command -v pixel >/dev/null 2>&1 && [ "$(pixel --version 2>/dev/null)" = "pixel $VERSION" ]; then
    exec pixel mcp
fi

case "$(uname -s)" in
    Linux) os="unknown-linux-musl" ;;
    Darwin) os="apple-darwin" ;;
    *) log "unsupported system: $(uname -s). On Windows use WSL, or set PIXEL_BIN."; exit 1 ;;
esac
case "$(uname -m)" in
    x86_64 | amd64) arch="x86_64" ;;
    aarch64 | arm64) arch="aarch64" ;;
    *) log "unsupported architecture: $(uname -m). Set PIXEL_BIN to a binary of your own."; exit 1 ;;
esac
asset="pixel-$VERSION-$arch-$os.tar.gz"

fetch() {
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --retry 2 -o "$2" "$1"
    elif command -v wget >/dev/null 2>&1; then
        wget -q -O "$2" "$1"
    else
        log "curl or wget is required to download the engine"
        return 1
    fi
}

sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    else
        shasum -a 256 "$1" | cut -d' ' -f1
    fi
}

mkdir -p "$cache"
tmp="$(mktemp -d "$cache/.download.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT

log "downloading the pixelcode engine $VERSION ($arch-$os), only this once..."
fetch "$BASE_URL/$asset" "$tmp/$asset" || { log "could not download $BASE_URL/$asset"; exit 1; }
fetch "$BASE_URL/$asset.sha256" "$tmp/$asset.sha256" || { log "could not download the checksum"; exit 1; }

expected="$(cut -d' ' -f1 "$tmp/$asset.sha256")"
actual="$(sha256 "$tmp/$asset")"
if [ "$expected" != "$actual" ]; then
    log "checksum mismatch for $asset (expected $expected, got $actual)"
    exit 1
fi

tar -xzf "$tmp/$asset" -C "$tmp"
chmod +x "$tmp/pixel"
mv "$tmp/pixel" "$bin"
log "ready: $bin"
exec "$bin" mcp
